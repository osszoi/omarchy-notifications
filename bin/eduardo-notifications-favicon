#!/usr/bin/env python3
# eduardo-notifications-favicon HOST OUTFILE
# Fetches the site's own icon (apple-touch-icon, then <link rel=icon>, then
# /favicon.ico) over https and writes it as a png. Only ever talks to HOST.

import os
import re
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request

HOST_RE = re.compile(r"^([a-z0-9-]+\.)+[a-z]{2,}$")
UA = "Mozilla/5.0 (X11; Linux x86_64) eduardo-notifications"
MAX_PAGE = 512 * 1024
MAX_ICON = 1024 * 1024


def fetch(url, limit):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=5) as r:
        final = urllib.parse.urlparse(r.geturl())
        if final.scheme != "https":
            raise ValueError("not https")
        return r.read(limit + 1)[:limit + 1], r.headers.get("Content-Type", "")


def candidates(host, html):
    found = []
    for tag in re.findall(r"<link\b[^>]*>", html, re.I):
        rel = re.search(r'rel\s*=\s*["\']?([^"\'>]+)', tag, re.I)
        href = re.search(r'href\s*=\s*["\']?([^"\'\s>]+)', tag, re.I)
        if not rel or not href:
            continue
        rel = rel.group(1).lower()
        if "icon" not in rel:
            continue
        size = re.search(r'sizes\s*=\s*["\']?(\d+)', tag, re.I)
        score = int(size.group(1)) if size else (180 if "apple-touch" in rel else 32)
        found.append((score, urllib.parse.urljoin("https://%s/" % host, href.group(1))))
    found.sort(key=lambda x: -x[0])
    urls = [u for _, u in found if u.startswith("https://")]
    urls.append("https://%s/favicon.ico" % host)
    return urls


def main():
    if len(sys.argv) != 3:
        sys.exit(2)
    host, outfile = sys.argv[1].lower(), sys.argv[2]
    if not HOST_RE.match(host):
        sys.exit(2)
    try:
        page, _ = fetch("https://%s/" % host, MAX_PAGE)
        html = page.decode("utf-8", "replace")
    except Exception:
        html = ""
    os.makedirs(os.path.dirname(outfile), exist_ok=True)
    for url in candidates(host, html):
        try:
            data, ctype = fetch(url, MAX_ICON)
        except Exception:
            continue
        if not data or len(data) > MAX_ICON:
            continue
        with tempfile.NamedTemporaryFile(dir=os.path.dirname(outfile), delete=False) as raw:
            raw.write(data)
            src = raw.name
        tmp = outfile + ".tmp.png"
        ok = subprocess.run(["magick", src + "[0]", "-resize", "128x128>", "png:" + tmp],
                            capture_output=True, timeout=10).returncode == 0
        os.unlink(src)
        if ok and os.path.getsize(tmp) > 0:
            os.replace(tmp, outfile)
            return
        if os.path.exists(tmp):
            os.unlink(tmp)
    sys.exit(1)


if __name__ == "__main__":
    main()
