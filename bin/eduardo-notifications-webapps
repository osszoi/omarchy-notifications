#!/usr/bin/env python3
# Prints {host: {name, icon}} for every installed web app launcher, so a
# notification from app.slack.com in chrome can show "Slack" and its icon.

import configparser
import glob
import json
import os
import re

URL_RE = re.compile(r"https?://([A-Za-z0-9.-]+\.[A-Za-z]{2,})")
DIRS = [
    os.path.expanduser("~/.local/share/applications"),
    os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
    "/usr/share/applications",
]


def host_of(text):
    m = URL_RE.search(text or "")
    if not m:
        return ""
    host = m.group(1).lower()
    return host[4:] if host.startswith("www.") else host


def main():
    apps = {}
    for d in DIRS:
        for path in sorted(glob.glob(os.path.join(d, "*.desktop"))):
            cp = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                cp.read(path, encoding="utf-8")
                entry = cp["Desktop Entry"]
            except Exception:
                continue
            host = host_of(entry.get("Exec", ""))
            if not host or host in apps:
                continue
            apps[host] = {"name": entry.get("Name", host), "icon": entry.get("Icon", "")}
    print(json.dumps(apps))


if __name__ == "__main__":
    main()
